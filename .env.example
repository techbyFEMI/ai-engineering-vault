# ─── WhatsApp Cloud API (Meta) ───────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token_here
WHATSAPP_VERIFY_TOKEN=my_secret_verify_token_123   # You choose this — must match Meta dashboard

# ─── OpenRouter LLM ──────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ─── App Settings ────────────────────────────────────────────────────────────
# Path to the active business config (swap this per client)
BUSINESS_CONFIG_PATH=config/business_config.yaml

# Set to true to log all conversations to conversations.jsonl
ENABLE_LOGGING=true
